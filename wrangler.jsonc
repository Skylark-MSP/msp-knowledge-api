{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msp-knowledge-api",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skylark-msp-kb-audit",
      "database_id": "76141aa5-0a97-4804-8bbc-a4050520bf17"
    }
  ]
}
